# Paperclip VPS environment — copy to /docker/paperclip/.env on the host (chmod 600).
# Cloudflare side and CI secrets: deploy/cloudflare/README.md
#
# Any of these keys can instead live in GitHub (secret or variable of the same name):
# the deploy workflow writes the ones you define into this file on every deploy and
# leaves the others as they are here. Secrets: DATABASE_URL, BETTER_AUTH_SECRET,
# PAPERCLIP_TOOL_ACTION_SIGNING_SECRET, PAPERCLIP_SECRETS_MASTER_KEY, R2_ACCESS_KEY_ID,
# R2_SECRET_ACCESS_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY. Variables:
# PAPERCLIP_HOSTNAME, PAPERCLIP_AUTH_DISABLE_SIGN_UP, PAPERCLIP_STORAGE_PROVIDER,
# PAPERCLIP_STORAGE_S3_BUCKET, PAPERCLIP_STORAGE_S3_ENDPOINT. TUNNEL_TOKEN is written
# too, read from the Cloudflare API (a TUNNEL_TOKEN secret overrides it).

# Image tag to run. The deploy workflow writes this line on every deploy.
PAPERCLIP_IMAGE_TAG=latest

# Public hostname, the same value as PAPERCLIP_HOSTNAME in deploy/cloudflare/.env
PAPERCLIP_HOSTNAME=paperclip.example.com

# Tunnel connector token. The deploy workflow fills it in from the Cloudflare API; by hand:
# `pnpm --dir deploy/cloudflare tunnel-token`, or Zero Trust → Networks → Tunnels →
# paperclip-<stage> in the dashboard.
TUNNEL_TOKEN=

# Hosted PostgreSQL (PlanetScale, Neon, Supabase, ...). Use the provider's direct,
# non-pooled port and its SSL requirement. Paperclip owns the `public` schema of the
# database named in the URL; it cannot be pointed at another schema.
# PlanetScale example (role credentials from the PlanetScale dashboard):
# DATABASE_URL=postgres://<role>:<password>@<host>.psdb.cloud:5432/<database>?sslmode=verify-full
DATABASE_URL=

# Independent secrets, each from `openssl rand -hex 32`. Keep them stable.
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# First admin: run `sh bootstrap-admin.sh` after the first `docker compose up -d` and open
# the printed invite URL (the browser claim button is off for internet-facing deployments).

# Recommended once everyone has an account: Paperclip's own login is the only gate, so
# the sign-up form is public. While true, invited people cannot create accounts either
# (the invite page's "Create account" form is the sign-up endpoint); set it back to false
# and `docker compose up -d` before onboarding anyone, then true again.
# PAPERCLIP_AUTH_DISABLE_SIGN_UP=true

# Optional LLM keys for local adapters.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: store uploads in Cloudflare R2. The bucket comes from the Alchemy stack
# (PAPERCLIP_R2_BUCKET or PAPERCLIP_R2_ASSETS in deploy/cloudflare); use the same name here.
# Create an R2 API token (Object Read & Write, scoped to the bucket) in the Cloudflare dashboard.
# PAPERCLIP_STORAGE_PROVIDER=s3
# PAPERCLIP_STORAGE_S3_BUCKET=paperclip
# PAPERCLIP_STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# With S3 storage, keep the secrets master key out of the volume too (openssl rand -hex 32):
# PAPERCLIP_SECRETS_MASTER_KEY=
